# Copy to .env and fill in. .env is gitignored; never commit a real token.

# Required. Fastmail API token with the scopes you actually need.
# Create at Fastmail > Settings > Privacy & Security > Integrations > API tokens.
FASTMAIL_API_TOKEN=

# Optional. JMAP endpoint. Defaults to https://api.fastmail.com
# Only api.fastmail.com and www.fastmailusercontent.com are accepted, each with
# an optional regional prefix. A self-hosted JMAP server also needs
# FASTMAIL_ALLOW_UNSAFE_BASE_URL=true.
# FASTMAIL_BASE_URL=https://api.fastmail.com

# Optional. Where download_attachment may write. Defaults to ~/Downloads/fastmail-mcp/
# FASTMAIL_DOWNLOAD_DIR=

# Optional. CalDAV (calendars). Needs an app password, not the API token.
# FASTMAIL_CALDAV_USERNAME=
# FASTMAIL_CALDAV_PASSWORD=
# FASTMAIL_CALDAV_DISPLAY_NAME=

# Optional. WebDAV (files). Needs an app password, not the API token.
# FASTMAIL_WEBDAV_URL=
# FASTMAIL_WEBDAV_USERNAME=
# FASTMAIL_WEBDAV_PASSWORD=

# Optional. Fork additions.
# Set to 1 to refuse every tool that writes. Good for a check-only session.
# FASTMAIL_READ_ONLY=
# Bulk tools over this many mails need confirm: true. Default 100.
# FASTMAIL_BULK_CONFIRM_THRESHOLD=100
# Append one JSON line per bulk operation to this file, for tracing and undo.
# FASTMAIL_AUDIT_LOG=
